        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='skin'] > Literal[value!=/^(?:shadow|bordered|none)$/]",
        "message": "<Card> skin must be one of 'shadow' | 'bordered' | 'none'."
