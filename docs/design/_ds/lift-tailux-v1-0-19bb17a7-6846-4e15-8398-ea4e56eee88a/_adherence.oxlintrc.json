{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data-display/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/_shared/**",
              "ui_kits/apps/**",
              "ui_kits/auth/**",
              "ui_kits/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:multiple|defaultValue|className|children|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: multiple, defaultValue, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|srcSet|alt|name|size|initialColor|initialVariant|indicator|component|className|classNames|children|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, srcSet, alt, name, size, initialColor, initialVariant, indicator, component, className, classNames, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='initialVariant'] > Literal[value!=/^(?:filled|soft)$/]",
        "message": "<Avatar> initialVariant must be one of 'filled' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|isPing|className|children|key|ref|className|style|children)$/]",
        "message": "<AvatarDot> doesn't accept that prop. Declared props: color, isPing, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|isGlow|unstyled|component|className|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, color, isGlow, unstyled, component, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|outlined|soft)$/]",
        "message": "<Badge> variant must be one of 'filled' | 'outlined' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Box'] > JSXAttribute > JSXIdentifier[name!=/^(?:component|className|children|key|ref|className|style|children)$/]",
        "message": "<Box> doesn't accept that prop. Declared props: component, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|variant|isIcon|isGlow|unstyled|disabled|component|className|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: color, variant, isIcon, isGlow, unstyled, disabled, component, className, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:skin|component|className|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: skin, component, className, children."
